# Bentam Chalk — payment backend secrets.
# Copy this file to ".env" and fill in real values from your Razorpay Dashboard.
# NEVER commit the real ".env" and NEVER put these in the browser / data.json / HTML.
#
# On a host (Render, Railway, a VM, etc.) set these as environment variables
# instead of a file. The Key Secret and Webhook Secret must only ever live here.

# Dashboard → Settings → API Keys (use TEST keys until you go live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Dashboard → Settings → Webhooks → create one pointing at
# https://YOUR_DOMAIN/api/razorpay-webhook  (subscribe to payment.captured)
# then paste the secret you set there:
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---- "Ask Bentam" AI assistant (optional) ----
# Turns the website chatbot from the offline knowledge base into a real AI that
# can answer open-ended questions about nutrition, soy, ingredients and the brand.
# Get a key at console.anthropic.com → API Keys. Keep it server-side only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Optional model override. Default is claude-opus-5 (most capable).
# For a high-traffic customer chatbot, claude-haiku-4-5 is ~5x cheaper:
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: override the port (defaults to 8080)
# PORT=8080
